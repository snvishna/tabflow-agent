{
  "manifest_version": 3,
  "name": "TabFlow Agent",
  "version": "1.0.1",
  "description": "Groups related tabs, prevents duplicate tabs, and lets you search open and archived tabs from a command palette.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "webNavigation",
    "alarms",
    "scripting",
    "activeTab",
    "sessions"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Open Tab Command Palette"
    },
    "undo-last-action": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Undo the last TabFlow action"
    }
  },
  "action": {
    "default_title": "Open TabFlow Agent",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["palette.html", "src/palette.js", "src/palette.css", "src/providers.js", "src/preview.js", "src/preview.css", "src/theme.css", "icons/icon-48.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabflow-agent@snvishna.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    }
  }
}
